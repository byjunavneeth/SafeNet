# Copy this file to .env and add your own Groq API key. The npm scripts load .env automatically.
GROQ_API_KEY=your_groq_api_key_here

# The default model is the current replacement for the retired Llama 3.1 8B Instant model.
GROQ_MODEL=openai/gpt-oss-20b

PORT=3000
# Optional. Defaults to ./data.json in the project root.
# DATA_FILE=./data.json
